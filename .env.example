# Base URL for the MTA relay. In dev this is empty (Vite proxies /mta).
# In production, point this at your deployed Cloudflare Worker.
# VITE_MTA_RELAY_URL=https://mta-relay.your-subdomain.workers.dev

# Vector basemap style URL. OpenFreeMap is the default.
VITE_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
